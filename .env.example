# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
# Optional Google Analytics 4 measurement ID. Analytics stays disabled until a visitor accepts it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Beta UI (free LC preview). Set to false when launching paid product UI.
NEXT_PUBLIC_BETA_MODE=true

# Supabase Dashboard → Authentication → URL configuration:
#   Site URL: http://localhost:3000
#   Redirect URLs: http://localhost:3000/auth/callback
# Production must use its canonical HTTPS domain for both values. Do not use broad
# wildcard redirect URLs. Enable CAPTCHA and leaked-password protection in Supabase
# before opening sign-up, sign-in, or password-reset flows to the public.
# Enable Email provider (and Google if using OAuth).

# Server-only
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5

# Optional: hybrid RAG vector path (OpenAI embeddings → Supabase match_exam_chunks).
# Without these, tutor/exam-gen still use local keyword RAG over docs/processed/**.
OPENAI_API_KEY=
# Set to false to force keyword-only even when OPENAI_API_KEY is present.
RAG_VECTOR_ENABLED=

# Optional CDN/object-storage base URL for scanned past-paper images. Until this
# is configured, deployed archive images fall back to the tracked public GitHub assets.
PAST_PAPER_ASSET_BASE_URL=

# Billing gate. Keep false while configuring Stripe; set true only after all four prices,
# the webhook and the customer portal are configured in Stripe.
BILLING_ENFORCEMENT=false
# Legacy name retained for existing deployments. Prefer BILLING_ENFORCEMENT above.
CHAT_REQUIRES_SUBSCRIPTION=false
# Local development automatically allows the two founders. In preview/production,
# add any trusted internal accounts explicitly as a comma-separated server-only list.
BILLING_PRIVILEGED_EMAILS=

# Stripe (Checkout + webhooks). All values are server-only except the publishable key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_INDIVIDUAL_SUBJECT_ID=
STRIPE_PRICE_ADDITIONAL_SUBJECT_ID=
STRIPE_PRICE_UP_TO_SEVEN_SUBJECTS_ID=
STRIPE_PRICE_UNLIMITED_SUBJECTS_ID=

# Supabase service role - use only in server routes (e.g. Stripe webhook, vector RAG RPC), never expose to client
SUPABASE_SERVICE_ROLE_KEY=
