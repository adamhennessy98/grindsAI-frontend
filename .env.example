# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: when true, /api/chat requires profiles.subscription_status = active
CHAT_REQUIRES_SUBSCRIPTION=false

# Stripe (Checkout + webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=

# Supabase service role - use only in server routes (e.g. Stripe webhook), never expose to client
SUPABASE_SERVICE_ROLE_KEY=
