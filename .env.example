# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Beta UI (free LC preview). Set to false when launching paid product UI.
NEXT_PUBLIC_BETA_MODE=true

# Supabase Dashboard → Authentication → URL configuration:
#   Site URL: http://localhost:3000
#   Redirect URLs: http://localhost:3000/auth/callback
# Enable Email provider (and Google if using OAuth).

# Server-only
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5

# Optional: hybrid RAG vector path (OpenAI embeddings → Supabase match_exam_chunks).
# Without these, tutor/exam-gen still use local keyword RAG over docs/processed/**.
OPENAI_API_KEY=
# Set to false to force keyword-only even when OPENAI_API_KEY is present.
RAG_VECTOR_ENABLED=

# Optional: when true, /api/chat requires profiles.subscription_status = active
CHAT_REQUIRES_SUBSCRIPTION=false

# Stripe (Checkout + webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=

# Supabase service role - use only in server routes (e.g. Stripe webhook, vector RAG RPC), never expose to client
SUPABASE_SERVICE_ROLE_KEY=
